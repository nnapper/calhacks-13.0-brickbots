{
  "name": "buildflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "node scripts/prepare-cad.mjs",
    "geometry": ".venv/bin/python -m uvicorn server.main:app --host 127.0.0.1 --port 8001",
    "backend": "convex dev",
    "catalog:discover": "node --env-file=.env scripts/catalog.mjs discover",
    "catalog:scrape": "node --env-file=.env scripts/catalog.mjs scrape",
    "enrich:dims": "node scripts/enrich.mjs dims",
    "enrich:images": "node scripts/enrich.mjs images",
    "prices:refresh": "node --env-file=.env scripts/apify-prices.mjs",
    "part:add": "node --env-file=.env scripts/add-part.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "convex": "^1.48.0",
    "occt-import-js": "0.0.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
